#!/usr/bin/env node
'use strict'

// Caelestia Git Panel -> cmoGit / GitXplorer bridge.
const { spawnSync } = require('node:child_process')
const path = require('node:path')
const fs = require('node:fs')

const method = process.argv[2] || 'snapshot'
const payload = process.argv[3] || '{}'

function fail(message) {
  process.stdout.write(JSON.stringify({
    ok: false,
    error: { message, code: 'BRIDGE_ERROR' }
  }) + '\n')
}

const home = process.env.HOME || ''
const candidates = [
  process.env.CMOGIT_BIN,
  path.join(home, 'code/ricing/GitX/bin/gitxplorer.cjs'),
  path.join(home, '.local/bin/cmogit'),
  path.join(home, '.local/bin/gitxplorer'),
  'gitxplorer',
  'cmogit'
].filter(Boolean)

let command = null
let isScript = false

for (const cand of candidates) {
  if (cand.includes('/') || cand.includes('\\')) {
    try {
      if (fs.existsSync(cand)) {
        command = cand
        isScript = /\.(c?js)$/i.test(cand)
        break
      }
    } catch {}
  } else {
    // Binary in PATH
    command = cand
    break
  }
}

if (!command) {
  fail('GitXplorer / cmoGit CLI not found. Install GitX or set CMOGIT_BIN.')
  process.exit(0)
}

let execCmd = command
let args

if (isScript) {
  execCmd = process.execPath
  args = [command, 'api', method, payload]
} else {
  args = ['api', method, payload]
}

const result = spawnSync(execCmd, args, {
  encoding: 'utf8',
  timeout: 120000,
  windowsHide: true,
  shell: process.platform === 'win32',
})

if (result.error) {
  fail(`Bridge execution failed: ${result.error.message}`)
  process.exit(0)
}

if (result.stdout && result.stdout.trim()) {
  process.stdout.write(result.stdout)
} else {
  const detail = (result.stderr || '').trim()
  fail(detail || 'Empty response from backend CLI.')
}
process.exit(0)
